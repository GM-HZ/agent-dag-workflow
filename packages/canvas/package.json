{
  "name": "@gm-hz/dsh-workflow-canvas",
  "version": "0.1.0",
  "description": "Authorized DSH Remote gateway and XYFlow visual studio for DAG workflows",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GM-HZ/dsh-workflow.git",
    "directory": "packages/canvas"
  },
  "homepage": "https://github.com/GM-HZ/dsh-workflow#readme",
  "keywords": ["deepseek", "dsh", "canvas", "xyflow", "dag", "workflow"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./host": { "types": "./lib/host.d.ts", "default": "./lib/host.js" },
    "./types": { "types": "./lib/types.d.ts", "default": "./lib/types.js" },
    "./client": { "types": "./lib/client/index.d.ts", "default": "./lib/client/index.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" }
  },
  "files": [
    "lib",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "generate:typert": "node scripts/generate-typert.mjs",
    "build": "pnpm generate:typert && tsc -p tsconfig.build.json",
    "test": "pnpm build && vitest run",
    "typecheck": "pnpm generate:typert && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gm-hz/dsh-workflow-core": "workspace:^",
    "@gm-hz/dsh-workflow-catalog": "workspace:^",
    "@gm-hz/dsh-workflow-dsh": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@xyflow/react": "^12.11.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
