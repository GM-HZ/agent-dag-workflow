{
  "name": "@gm-hz/dsh-workflow-sqlite",
  "version": "0.1.0",
  "description": "Node SQLite persistence providers for DSH workflow templates and runs",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GM-HZ/dsh-workflow.git",
    "directory": "packages/sqlite"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "files": ["lib", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gm-hz/dsh-workflow-catalog": "workspace:^",
    "@gm-hz/dsh-workflow-core": "workspace:^",
    "@gm-hz/dsh-workflow-dsh": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
