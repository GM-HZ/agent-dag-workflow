{
  "name": "@gm-hz/dsh-dag-workflow-host",
  "version": "0.1.3",
  "description": "Cordis service provider that integrates DSH with the DAG workflow core",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GM-HZ/dsh-dag-workflow.git",
    "directory": "packages/dsh"
  },
  "bugs": { "url": "https://github.com/GM-HZ/dsh-dag-workflow/issues" },
  "homepage": "https://github.com/GM-HZ/dsh-dag-workflow#readme",
  "keywords": ["deepseek", "deepseek-harness", "dsh", "dsh-plugin", "cordis", "dag", "workflow"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": ["lib", "src", "skills"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gm-hz/dsh-dag-workflow-catalog": "workspace:^",
    "@gm-hz/dsh-dag-workflow-core": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
