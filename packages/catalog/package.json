{
  "name": "@gm-hz/dsh-workflow-catalog",
  "version": "0.1.0",
  "description": "Draft, CAS, validation and immutable revision catalog for DSH workflows",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GM-HZ/dsh-workflow.git",
    "directory": "packages/catalog"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" }
  },
  "files": ["lib", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gm-hz/dsh-workflow-core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
