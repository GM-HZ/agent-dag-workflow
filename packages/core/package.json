{
  "name": "@gm-hz/dsh-workflow-core",
  "version": "0.1.0",
  "description": "Plugin-extensible DAG workflow compiler and runtime for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GM-HZ/dsh-workflow.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/GM-HZ/dsh-workflow#readme",
  "keywords": ["deepseek", "dsh", "dag", "workflow"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
