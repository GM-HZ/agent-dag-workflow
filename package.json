{
  "name": "@gm-hz/agent-dag-workflow",
  "version": "1.0.0",
  "description": "Host-neutral durable DAG workflows for Agents, Tools, Skills, MCP, triggers, replay, and visual Canvas",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm sync:codex-plugin && pnpm clean && pnpm generate:typert && tsc -p tsconfig.build.json && tsdown --config canvas.tsdown.config.ts",
    "check": "pnpm typecheck && pnpm test",
    "demo": "pnpm build && node examples/run-approval-gate.mjs && node examples/run-script-transform.mjs",
    "example:weekly": "pnpm build && node examples/run-weekly-ai-model-news.mjs",
    "generate:typert": "node scripts/canvas/generate-typert.mjs",
    "showcase:install": "pnpm build && node examples/install-showcases.mjs",
    "sync:codex-plugin": "node scripts/sync-codex-plugin.mjs",
    "prepare": "pnpm build",
    "test": "pnpm build && vitest run",
    "typecheck": "pnpm generate:typert && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test-core.json --noEmit && tsc -p tsconfig.test-catalog.json --noEmit && tsc -p tsconfig.test-dsh.json --noEmit && tsc -p tsconfig.test-sqlite.json --noEmit && tsc -p tsconfig.test-canvas.json --noEmit && tsc -p tsconfig.test-verification.json --noEmit",
    "verify:core": "pnpm generate:typert && tsc -p tsconfig.test-verification.json --noEmit && vitest run tests/verification",
    "verify:pack": "pnpm build && node scripts/verify-packed-install.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "default": "./lib/core/index.js"
    },
    "./catalog": {
      "types": "./lib/catalog/index.d.ts",
      "default": "./lib/catalog/index.js"
    },
    "./runtime": {
      "types": "./lib/runtime/index.d.ts",
      "default": "./lib/runtime/index.js"
    },
    "./access": {
      "types": "./lib/access/index.d.ts",
      "default": "./lib/access/index.js"
    },
    "./journal": {
      "types": "./lib/journal/index.d.ts",
      "default": "./lib/journal/index.js"
    },
    "./triggers": {
      "types": "./lib/triggers/core/index.d.ts",
      "default": "./lib/triggers/core/index.js"
    },
    "./triggers/cron": {
      "types": "./lib/triggers/cron/index.d.ts",
      "default": "./lib/triggers/cron/index.js"
    },
    "./triggers/webhook": {
      "types": "./lib/triggers/webhook/index.d.ts",
      "default": "./lib/triggers/webhook/index.js"
    },
    "./triggers/dingtalk": {
      "types": "./lib/triggers/dingtalk/index.d.ts",
      "default": "./lib/triggers/dingtalk/index.js"
    },
    "./mcp": {
      "types": "./lib/adapters/mcp/index.d.ts",
      "default": "./lib/adapters/mcp/index.js"
    },
    "./cli": {
      "types": "./lib/adapters/cli/index.d.ts",
      "default": "./lib/adapters/cli/index.js"
    },
    "./sqlite": {
      "types": "./lib/storage/sqlite/index.d.ts",
      "default": "./lib/storage/sqlite/index.js"
    },
    "./dsh": {
      "types": "./lib/adapters/dsh/bundle.d.ts",
      "default": "./lib/adapters/dsh/bundle.js"
    },
    "./dsh/host": {
      "types": "./lib/adapters/dsh/index.d.ts",
      "default": "./lib/adapters/dsh/index.js"
    },
    "./canvas": {
      "types": "./lib/canvas/index.d.ts",
      "default": "./lib/canvas/index.js"
    },
    "./canvas/types": {
      "types": "./lib/canvas/types.d.ts",
      "default": "./lib/canvas/types.js"
    },
    "./client": {
      "types": "./lib/canvas/client/index.d.ts",
      "default": "./lib/canvas/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-workflow": "lib/cli.js",
    "agent-workflow-mcp": "lib/mcp-cli.js"
  },
  "files": [
    "lib",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "docs",
    "examples",
    "spec",
    "skills",
    "integrations/codex/.agents/plugins/marketplace.json",
    "integrations/codex/agent-dag-workflow",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xyflow/react": "^12.11.3",
    "ajv": "^8.20.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6 <0.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GM-HZ/agent-dag-workflow.git"
  },
  "keywords": [
    "agent",
    "dag",
    "workflow",
    "mcp",
    "skill",
    "canvas",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "author": "GM-HZ",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/GM-HZ/agent-dag-workflow/issues"
  },
  "homepage": "https://github.com/GM-HZ/agent-dag-workflow#readme",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "lib": "lib",
    "test": "tests"
  }
}
